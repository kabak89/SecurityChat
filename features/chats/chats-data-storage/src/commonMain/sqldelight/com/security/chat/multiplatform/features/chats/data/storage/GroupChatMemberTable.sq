CREATE TABLE GroupChatMemberTable (
    groupChatId TEXT NOT NULL,
    userId TEXT NOT NULL,
    PRIMARY KEY (groupChatId, userId)
);

CREATE INDEX group_chat_member_user_idx ON GroupChatMemberTable(userId);

insert:
INSERT OR REPLACE INTO GroupChatMemberTable
VALUES ?;

getUserIdsByGroupChatId:
SELECT userId FROM GroupChatMemberTable
WHERE groupChatId = :groupChatId;

deleteByGroupChatId:
DELETE FROM GroupChatMemberTable
WHERE groupChatId = :groupChatId;

deleteByUserId:
DELETE FROM GroupChatMemberTable
WHERE userId = :userId;

removeAll:
DELETE FROM GroupChatMemberTable;