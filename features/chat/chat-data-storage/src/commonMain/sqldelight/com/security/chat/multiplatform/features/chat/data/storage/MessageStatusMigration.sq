CREATE TABLE MessageStatusMigration (
  messageId TEXT PRIMARY KEY NOT NULL
);

getPendingCount:
SELECT count(*) FROM MessageStatusMigration;

initializeLocalStatuses:
INSERT OR REPLACE INTO MessageRecipients (messageId, userId, status)
SELECT MessageTable.id, :userId,
  CASE WHEN MessageTable.authorId = :userId THEN 'Sent' ELSE 'Read' END
FROM MessageTable
JOIN MessageStatusMigration ON MessageStatusMigration.messageId = MessageTable.id;

removeAll:
DELETE FROM MessageStatusMigration;
