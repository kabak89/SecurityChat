<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Required only for debug builds that talk to a server on the local network
        (e.g. http://192.168.x.x). Starting with target SDK 37 (Android 17) local
        network access is blocked by default and guarded by this runtime permission.
        Release builds use a remote HTTPS host, so the permission stays out of them.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        Keeps debug builds out of the Crashlytics dashboard. Disabling collection covers both
        fatal crashes caught by the SDK itself and non-fatal events reported through Log.e.
    -->
    <application>

        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

    </application>

</manifest>
