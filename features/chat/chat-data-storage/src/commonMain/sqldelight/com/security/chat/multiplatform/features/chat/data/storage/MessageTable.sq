CREATE TABLE MessageTable (
  id TEXT PRIMARY KEY NOT NULL,
  chatId TEXT NOT NULL,
  authorId TEXT NOT NULL,
  status TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  type TEXT NOT NULL
);

-- Covers keyset pagination: WHERE chatId = ? ORDER BY timestamp, id (both ASC and DESC scans).
CREATE INDEX MessageTable_chatId_timestamp_id ON MessageTable(chatId, timestamp, id);

insert:
INSERT OR REPLACE INTO MessageTable
VALUES ?;

-- The read queries below LEFT JOIN every detail table. Only the payload columns of the row's
-- `type` are non-null (text for Text; fileId + key for Image). When a new message type is added,
-- add its detail table as another LEFT JOIN and its payload columns here.

getPaged:
SELECT MessageTable.id, MessageTable.chatId, MessageTable.authorId, MessageTable.status, MessageTable.timestamp, MessageTable.type, TextMessageTable.text, ImageMessageTable.fileId, ImageMessageTable.key, ImageMessageTable.localPath
FROM MessageTable
LEFT JOIN TextMessageTable ON TextMessageTable.id = MessageTable.id
LEFT JOIN ImageMessageTable ON ImageMessageTable.id = MessageTable.id
WHERE MessageTable.chatId = ?
ORDER BY MessageTable.timestamp DESC, MessageTable.id DESC
LIMIT :limit
OFFSET :offset;

getNewest:
SELECT MessageTable.id, MessageTable.chatId, MessageTable.authorId, MessageTable.status, MessageTable.timestamp, MessageTable.type, TextMessageTable.text, ImageMessageTable.fileId, ImageMessageTable.key, ImageMessageTable.localPath
FROM MessageTable
LEFT JOIN TextMessageTable ON TextMessageTable.id = MessageTable.id
LEFT JOIN ImageMessageTable ON ImageMessageTable.id = MessageTable.id
WHERE MessageTable.chatId = :chatId
ORDER BY MessageTable.timestamp DESC, MessageTable.id DESC
LIMIT :limit;

getOlderThan:
SELECT MessageTable.id, MessageTable.chatId, MessageTable.authorId, MessageTable.status, MessageTable.timestamp, MessageTable.type, TextMessageTable.text, ImageMessageTable.fileId, ImageMessageTable.key, ImageMessageTable.localPath
FROM MessageTable
LEFT JOIN TextMessageTable ON TextMessageTable.id = MessageTable.id
LEFT JOIN ImageMessageTable ON ImageMessageTable.id = MessageTable.id
WHERE MessageTable.chatId = :chatId
  AND MessageTable.timestamp < :beforeTimestamp
ORDER BY MessageTable.timestamp DESC, MessageTable.id DESC
LIMIT :limit;

getClosestNewerThan:
SELECT MessageTable.id, MessageTable.chatId, MessageTable.authorId, MessageTable.status, MessageTable.timestamp, MessageTable.type, TextMessageTable.text, ImageMessageTable.fileId, ImageMessageTable.key, ImageMessageTable.localPath
FROM MessageTable
LEFT JOIN TextMessageTable ON TextMessageTable.id = MessageTable.id
LEFT JOIN ImageMessageTable ON ImageMessageTable.id = MessageTable.id
WHERE MessageTable.chatId = :chatId
  AND MessageTable.timestamp > :afterTimestamp
ORDER BY MessageTable.timestamp ASC, MessageTable.id ASC
LIMIT :limit;

getByTimestamp:
SELECT MessageTable.id, MessageTable.chatId, MessageTable.authorId, MessageTable.status, MessageTable.timestamp, MessageTable.type, TextMessageTable.text, ImageMessageTable.fileId, ImageMessageTable.key, ImageMessageTable.localPath
FROM MessageTable
LEFT JOIN TextMessageTable ON TextMessageTable.id = MessageTable.id
LEFT JOIN ImageMessageTable ON ImageMessageTable.id = MessageTable.id
WHERE MessageTable.timestamp = ?;

removeAll:
DELETE FROM MessageTable;
